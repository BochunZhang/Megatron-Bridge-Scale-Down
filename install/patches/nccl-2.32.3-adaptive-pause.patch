+extern int64_t ncclParamSymAgStmcRsPauseCycles();
+NCCL_PARAM(SymAgStmcPauseCycles, "SYM_AG_STMC_PAUSE_CYCLES", -1)
+NCCL_PARAM(SymAgStmcPausePollChunks, "SYM_AG_STMC_PAUSE_POLL_CHUNKS", 4)
+
+static uint32_t symAgStmcPauseCycles(int64_t cycles) {
+  return static_cast<uint32_t>(std::clamp(cycles, int64_t{0}, int64_t{UINT32_MAX}));
+}
+
+struct ncclSymkAgStmcPauseDefaults {
+  uint32_t idleCycles;
+  uint32_t rsCycles;
+};
+
+static ncclSymkAgStmcPauseDefaults symAgStmcPauseDefaults(int nRanks, int nChannels, int nWarps) {
+  // GB200 1 GiB STMC + LDMC sweep: the AG-only bandwidth plateau and the
+  // minimum AG+RS makespan for each measured communicator size.
+  switch (nRanks) {
+  case 4:
+  case 8:
+  case 16:
+    return {1024, 3072};
+  case 32:
+    return {4096, 7168};
+  case 64:
+    return {9728, 16384};
+  default:
+    break;
+  }
+
+  // Estimate the overlap pause from the number of sending warps for other sizes.
+  const int64_t writers = int64_t(nRanks) * nChannels * nWarps;
+  if (writers <= 256) return {0, symAgStmcPauseCycles(12 * writers)};
+  if (writers <= 512) return {0, symAgStmcPauseCycles(3072 + 16 * (writers - 256))};
+  return {0, symAgStmcPauseCycles(7168 + 18 * (writers - 512))};
+}

