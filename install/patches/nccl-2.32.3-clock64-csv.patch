+namespace {
+struct SymClock64Capture {
+  ncclSymClock64Row* rows;
+  uint32_t capacity, launches, stride, groupSize;
+  uint32_t next[2];
+  int device;
+};
+
+std::mutex symClock64Mutex;
+SymClock64Capture symClock64Capture = {};
+}
+
+// Private benchmark entry point. The caller owns the zeroed device buffer and
+// keeps it alive through device synchronization. One capture per process.
+extern "C" __attribute__((visibility("default"))) ncclResult_t ncclSymClock64Register(
+    void* rows, uint32_t capacity, uint32_t launches, uint32_t stride, uint32_t groupSize) {
+  std::lock_guard<std::mutex> lock(symClock64Mutex);
+  if (rows == nullptr) {
+    symClock64Capture = {};
+    return ncclSuccess;
+  }
+  if (symClock64Capture.rows || !capacity || !launches || !stride || !groupSize)
+    return ncclInvalidUsage;
+  cudaPointerAttributes attr;
+  if (cudaPointerGetAttributes(&attr, rows) != cudaSuccess || attr.type != cudaMemoryTypeDevice)
+    return ncclInvalidArgument;
+  symClock64Capture = {static_cast<ncclSymClock64Row*>(rows), capacity, launches, stride, groupSize, {}, attr.device};
+  return ncclSuccess;
+}
+
+static ncclResult_t symClock64Bind(ncclComm* comm, ncclSymkKernelId kernelId, const ncclKernelPlan* plan,
+                                  int workCount, int nMaxChannels, size_t nBytes, ncclSymClock64Args* clock64) {
+  int op = kernelId == ncclSymkKernelId_AllGather_STMC ? 0 :
+           kernelId == ncclSymkKernelId_ReduceScatter_LDMC ? 1 : -1;
+  if (op < 0) return ncclSuccess;
+  std::lock_guard<std::mutex> lock(symClock64Mutex);
+  auto& capture = symClock64Capture;
+  if (capture.rows == nullptr || comm->cudaDev != capture.device) return ncclSuccess;
+
+  // A group-major table has at most ceil(nTiles / tilesPerGroup) + nWarps
+  // slots, including unused slots in the last group. Each warp owns its slots.
+  uint64_t nTiles = nBytes / 4096;
+  uint64_t tilesPerGroup = uint64_t(capture.stride) * capture.groupSize;
+  uint64_t nWarps = uint64_t(nMaxChannels) * (plan->threadPerBlock / WARP_SIZE);
+  uint64_t required = nTiles / tilesPerGroup + (nTiles % tilesPerGroup != 0) + nWarps;
+  if (plan->persistent || workCount != 1 || capture.next[op] >= capture.launches || required > capture.capacity) {
+    WARN("Clock64 capture expects one non-graph work item per launch and a sufficiently large buffer");
+    return ncclInvalidUsage;
+  }
+  size_t slot = size_t(op) * capture.launches + capture.next[op]++;
+  *clock64 = {capture.rows + slot * capture.capacity, capture.stride, capture.groupSize};
+  return ncclSuccess;
+}
