+static __device__ __forceinline__ uint32_t ncclSymClock64FirstTile(ncclSymClock64Args args) {
+  if (args.rows == nullptr) return 0;
+  uint32_t warp = blockIdx.x * (blockDim.x / WARP_SIZE) + threadIdx.x / WARP_SIZE;
+  return 1 + warp % args.stride;
+}
