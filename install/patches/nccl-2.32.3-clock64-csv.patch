+static __device__ __forceinline__ uint64_t ncclSymClock64() {
+  uint64_t cycles;
+  asm volatile("mov.u64 %0, %%clock64;" : "=l"(cycles) :: "memory");
+  return cycles;
+}
+
+struct ncclSymClock64Sample {
+  uint64_t cycles[3];
+  bool valid;
+};
+
+// Each row is written by one lane. No atomics or in-kernel printing are needed.
+struct ncclSymClock64Stats {
+  ncclSymClock64Row row = {};
+  uint32_t group = 0;
+
+  __device__ void flush(ncclSymClock64Args args) {
+    if (row.n == 0) return;
+    uint32_t warpsPerCta = blockDim.x / WARP_SIZE;
+    row.cta = blockIdx.x;
+    row.warp = threadIdx.x / WARP_SIZE;
+    size_t warp = size_t(row.cta) * warpsPerCta + row.warp;
+    args.rows[size_t(group++) * gridDim.x * warpsPerCta + warp] = row;
+    row = {};
+  }
+
+  __device__ void add(ncclSymClock64Args args, uint32_t tile, ncclSymClock64Sample sample) {
+    if (threadIdx.x % WARP_SIZE != 0 || !sample.valid) return;
+    if (row.n++ == 0) row.firstTile = tile;
+    row.lastTile = tile;
+    NVCC_PRAGMA_UNROLL_AUTO
+    for (int i = 0; i < 3; ++i) {
+      row.sum[i] += sample.cycles[i];
+      row.max[i] = row.max[i] < sample.cycles[i] ? sample.cycles[i] : row.max[i];
+    }
+    if (row.n == args.groupSize) flush(args);
+  }
+};
