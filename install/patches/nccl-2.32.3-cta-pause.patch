+// nccl-2.32.3-cta-pause: spin the calling warp for pauseCycles of clock64 (the SM's cycle counter). It advances
+// every SM cycle, so the pause is exact to a few cycles; in ns it is pauseCycles / SM clock, which moves with
+// the clock the SM runs at (lock it with nvidia-smi -lgc for a fixed ns). %globaltimer is not used: how often it
+// advances is up to the GPU and the driver, and a coarse tick would make short pauses indistinguishable.
+static __device__ __forceinline__ void ncclSymkPauseCycles(uint32_t pauseCycles) {
+  long long start = clock64();
+  while (clock64() - start < (long long)pauseCycles) {
+  }
+}
