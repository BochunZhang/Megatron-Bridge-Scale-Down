+// nccl-2.32.3-pause-with-debug: the SM's cycle counter. It advances every SM cycle (ns = cycles / SM clock; lock
+// the clock with nvidia-smi -lgc for a fixed ns). The "memory" clobber keeps the compiler from moving the stores
+// across the reads.
+static __device__ __forceinline__ long long ncclSymkClock64() {
+  long long cycles;
+  asm volatile("mov.u64 %0, %%clock64;" : "=l"(cycles)::"memory");
+  return cycles;
+}
+
+// nccl-2.32.3-pause-with-debug: spin the calling warp for pauseCycles of clock64. %globaltimer is not used: how
+// often it advances is up to the GPU and the driver, and a coarse tick would make short pauses indistinguishable.
+static __device__ __forceinline__ void ncclSymkPauseCycles(uint32_t pauseCycles) {
+  long long start = ncclSymkClock64();
+  while (ncclSymkClock64() - start < (long long)pauseCycles) {
+  }
+}
+
+// nccl-2.32.3-pause-with-debug: the multimem.st cycles of the last n chunks of the calling warp, from its lane 0.
+// iter counts the warp's chunks so far in this bcastMultimem; globaltimer (ns) places the line in time across
+// SMs and GPUs (clock64 is per SM). Device printf lands in a FIFO (cudaLimitPrintfFifoSize, 1 MiB by default)
+// that the host prints to stdout at the next synchronization; lines past its end are dropped.
+static __device__ __noinline__ void ncclSymkPrintStCycles(ncclSymkAgStmcDebug dbg, int rank, uint32_t iter, uint32_t n,
+                                                          unsigned long long sum, uint32_t lo, uint32_t hi,
+                                                          uint32_t last) {
+  unsigned long long globaltimer;
+  asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(globaltimer));
+  printf("[nccl-ag-stmc-st] launch=%u rank=%d cta=%u warp=%u iter=%u n=%u sum=%llu min=%u max=%u last=%u "
+         "pause=%u globaltimer=%llu\n",
+         dbg.launch, rank, blockIdx.x, threadIdx.x / WARP_SIZE, iter, n, sum, lo, hi, last, dbg.pauseCycles,
+         globaltimer);
+}
