diff --git a/src/device/fused_ag_rs.cu b/src/device/fused_ag_rs.cu
new file mode 100644
index 00000000..74893799
--- /dev/null
+++ b/src/device/fused_ag_rs.cu
@@ -0,0 +1,107 @@
+/*************************************************************************
+ * SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * See LICENSE.txt for more license information
+ *************************************************************************/
+
+#include "core.h"
+#include "nccl_device.h"
+#include <cuda_runtime.h>
+
+namespace {
+
+constexpr int FusedThreads = 256;
+
+#if __CUDA_ARCH__ >= 900
+template <int PackBytes>
+__device__ __forceinline__ void gatherPack(uintptr_t src, uintptr_t dst) {
+  if constexpr (PackBytes == 16) {
+    asm volatile("{ .reg .b32 p<4>;"
+                 "ld.global.v4.b32 {p0,p1,p2,p3}, [%0];"
+                 "multimem.st.global.v4.f32 [%1], {p0,p1,p2,p3}; }" ::"l"(src), "l"(dst) : "memory");
+  } else {
+    asm volatile("{ .reg .b32 p;"
+                 "ld.global.b32 p, [%0];"
+                 "multimem.st.global.b32 [%1], p; }" ::"l"(src), "l"(dst) : "memory");
+  }
+}
+
+template <int PackBytes>
+__device__ __forceinline__ void scatterPack(uintptr_t src, uintptr_t dst) {
+  if constexpr (PackBytes == 16) {
+    asm volatile("{ .reg .b32 p<4>;"
+                 "multimem.ld_reduce.relaxed.sys.global.add.acc::f32.v4.bf16x2 {p0,p1,p2,p3}, [%0];"
+                 "st.global.v4.b32 [%1], {p0,p1,p2,p3}; }" ::"l"(src), "l"(dst) : "memory");
+  } else {
+    asm volatile("{ .reg .b32 p;"
+                 "multimem.ld_reduce.relaxed.sys.global.add.acc::f32.bf16x2 p, [%0];"
+                 "st.global.b32 [%1], p; }" ::"l"(src), "l"(dst) : "memory");
+  }
+}
+
+template <int PackBytes>
+__device__ __forceinline__ void fusedPacks(uintptr_t agSrc, uintptr_t agDst, size_t agBytes, uintptr_t rsSrc,
+                                           uintptr_t rsDst, size_t rsBytes) {
+  size_t agPacks = agBytes / PackBytes;
+  size_t rsPacks = rsBytes / PackBytes;
+  size_t pairedPacks = agPacks < rsPacks ? agPacks : rsPacks;
+  size_t stride = size_t(gridDim.x) * blockDim.x;
+  size_t pack = size_t(blockIdx.x) * blockDim.x + threadIdx.x;
+  // With independent buffers, the multicast store needs no fence before the reduce load.
+  // Finish each pack's store before introducing the next payload at the PTX level.
+  #pragma unroll 1
+  for (; pack < pairedPacks; pack += stride) {
+    size_t offset = pack * PackBytes;
+    gatherPack<PackBytes>(agSrc + offset, agDst + offset);
+    scatterPack<PackBytes>(rsSrc + offset, rsDst + offset);
+  }
+  #pragma unroll 1
+  for (; pack < agPacks; pack += stride) {
+    size_t offset = pack * PackBytes;
+    gatherPack<PackBytes>(agSrc + offset, agDst + offset);
+  }
+  #pragma unroll 1
+  for (; pack < rsPacks; pack += stride) {
+    size_t offset = pack * PackBytes;
+    scatterPack<PackBytes>(rsSrc + offset, rsDst + offset);
+  }
+}
+#endif
+
+} // namespace
+
+extern "C" __global__ __launch_bounds__(FusedThreads) void ncclDevKernel_FusedAllGatherReduceScatter(
+  const __grid_constant__ ncclDevComm_t devComm, uintptr_t agSrc, uintptr_t agDst, size_t agBytes, uintptr_t rsSrc,
+  uintptr_t rsDst, size_t rsBytes) {
+#if __CUDA_ARCH__ >= 900
+  ncclLsaBarrierSession<ncclCoopCta> bar{
+    ncclCoopCta(), devComm, ncclTeamTagLsa(), blockIdx.x, /*multimem=*/true};
+  bar.sync(ncclCoopCta(), cuda::memory_order_acq_rel);
+
+  if ((agSrc | agDst | rsSrc | rsDst) % 16 == 0) {
+    fusedPacks<16>(agSrc, agDst, agBytes, rsSrc, rsDst, rsBytes);
+    size_t agMain = agBytes & ~size_t(15);
+    size_t rsMain = rsBytes & ~size_t(15);
+    agSrc += agMain;
+    agDst += agMain;
+    agBytes -= agMain;
+    rsSrc += rsMain;
+    rsDst += rsMain;
+    rsBytes -= rsMain;
+  }
+  fusedPacks<4>(agSrc, agDst, agBytes, rsSrc, rsDst, rsBytes);
+
+  // Publish AG writes and wait for peer RS reads before this stream can reuse either window.
+  bar.sync(ncclCoopCta(), cuda::memory_order_acq_rel);
+#endif
+}
+
+ncclResult_t ncclLaunchFusedAllGatherReduceScatter(const ncclDevComm_t* devComm, uintptr_t agSrc, uintptr_t agDst,
+                                                    size_t agBytes, uintptr_t rsSrc, uintptr_t rsDst, size_t rsBytes,
+                                                    int ctas, cudaStream_t stream) {
+  void* args[] = {const_cast<ncclDevComm_t*>(devComm), &agSrc, &agDst, &agBytes, &rsSrc, &rsDst, &rsBytes};
+  CUDACHECK(cudaLaunchKernel(reinterpret_cast<const void*>(ncclDevKernel_FusedAllGatherReduceScatter), ctas,
+                             FusedThreads, args, 0, stream));
+  return ncclSuccess;
+}
