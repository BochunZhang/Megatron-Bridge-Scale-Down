diff --git a/src/device/fused_ag_rs.cu b/src/device/fused_ag_rs.cu
new file mode 100644
index 00000000..11122127
--- /dev/null
+++ b/src/device/fused_ag_rs.cu
@@ -0,0 +1,228 @@
+/*************************************************************************
+ * SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * See LICENSE.txt for more license information
+ *************************************************************************/
+
+#include "core.h"
+#include "nccl_device.h"
+#include "sym_kernels.h"
+#include <cuda_runtime.h>
+
+namespace {
+
+constexpr int FusedThreads = 256;
+
+#if __CUDA_ARCH__ >= 900
+constexpr int WarpSize = 32;
+constexpr int PackBytes = 16;
+constexpr int TileBytes = ncclSymkMultimemDeepBytePerChunk;
+static_assert(TileBytes == 8 * WarpSize * PackBytes);
+
+// Each tile has eight 16-byte packs per lane. Keep all eight loads ahead of
+// their stores in PTX, matching the STMC and LDMC warp loops.
+#define NCCL_FUSED_TILE_OPS(Op) \
+  Op(0, 1, 2, 3, 0) Op(4, 5, 6, 7, 512) Op(8, 9, 10, 11, 1024) Op(12, 13, 14, 15, 1536) \
+  Op(16, 17, 18, 19, 2048) Op(20, 21, 22, 23, 2560) Op(24, 25, 26, 27, 3072) Op(28, 29, 30, 31, 3584)
+#define NCCL_FUSED_PACK(a, b, c, d) "{p" #a ",p" #b ",p" #c ",p" #d "}"
+#define NCCL_FUSED_LOAD(a, b, c, d, off) \
+  "ld.global.v4.b32 " NCCL_FUSED_PACK(a, b, c, d) ", [%0+" #off "];"
+#define NCCL_FUSED_MCSTORE(a, b, c, d, off) \
+  "multimem.st.global.v4.f32 [%1+" #off "], " NCCL_FUSED_PACK(a, b, c, d) ";"
+#define NCCL_FUSED_REDUCE(a, b, c, d, off) \
+  "multimem.ld_reduce.relaxed.sys.global.add.acc::f32.v4.bf16x2 " NCCL_FUSED_PACK(a, b, c, d) ", [%0+" #off "];"
+#define NCCL_FUSED_STORE(a, b, c, d, off) \
+  "st.global.v4.b32 [%1+" #off "], " NCCL_FUSED_PACK(a, b, c, d) ";"
+
+template <bool Gather>
+__device__ __forceinline__ void transferTile(uintptr_t src, uintptr_t dst) {
+  if constexpr (Gather) {
+    asm volatile("{ .reg .b32 p<32>;"
+                 NCCL_FUSED_TILE_OPS(NCCL_FUSED_LOAD) NCCL_FUSED_TILE_OPS(NCCL_FUSED_MCSTORE)
+                 "}" ::"l"(src), "l"(dst) : "memory");
+  } else {
+    asm volatile("{ .reg .b32 p<32>;"
+                 NCCL_FUSED_TILE_OPS(NCCL_FUSED_REDUCE) NCCL_FUSED_TILE_OPS(NCCL_FUSED_STORE)
+                 "}" ::"l"(src), "l"(dst) : "memory");
+  }
+}
+
+#undef NCCL_FUSED_TILE_OPS
+#undef NCCL_FUSED_PACK
+#undef NCCL_FUSED_LOAD
+#undef NCCL_FUSED_MCSTORE
+#undef NCCL_FUSED_REDUCE
+#undef NCCL_FUSED_STORE
+
+template <bool Gather>
+__device__ __forceinline__ void transferWord(uintptr_t src, uintptr_t dst) {
+  if constexpr (Gather) {
+    asm volatile("{ .reg .b32 p;"
+                 "ld.global.b32 p, [%0];"
+                 "multimem.st.global.b32 [%1], p; }" ::"l"(src), "l"(dst) : "memory");
+  } else {
+    asm volatile("{ .reg .b32 p;"
+                 "multimem.ld_reduce.relaxed.sys.global.add.acc::f32.bf16x2 p, [%0];"
+                 "st.global.b32 [%1], p; }" ::"l"(src), "l"(dst) : "memory");
+  }
+}
+
+struct Transfer {
+  uintptr_t src, dst;
+  size_t bytes, prefix, tiles;
+};
+
+__device__ __forceinline__ Transfer makeTransfer(uintptr_t src, uintptr_t dst, size_t bytes) {
+  // Match the stock prefix alignment independently for each operation. If the
+  // endpoints have different alignment, transfer the full range in 4-byte words.
+  size_t prefix = (src - dst) % PackBytes == 0 ? -src % PackBytes : bytes;
+  prefix = min(bytes, prefix);
+  return {src, dst, bytes, prefix, (bytes - prefix) / TileBytes};
+}
+
+__device__ __forceinline__ size_t startTile(size_t tiles, unsigned int rank, size_t warp) {
+  // The stock STMC and LDMC permutation starts each rank at a different offset.
+  const unsigned int multiplier = rank ^ ((rank >> 1) & 1);
+  const size_t skew = size_t(multiplier) * (ncclSymkMcPerRankOffsetBytes / TileBytes);
+  return warp + (tiles == 0 ? 0 : skew % tiles);
+}
+
+template <bool Gather>
+__device__ __forceinline__ void nextTile(const Transfer& transfer, size_t& tile, size_t stride) {
+  if (tile >= transfer.tiles) tile -= transfer.tiles;
+  const size_t offset = transfer.prefix + tile * TileBytes + (threadIdx.x % WarpSize) * PackBytes;
+  transferTile<Gather>(transfer.src + offset, transfer.dst + offset);
+  tile += stride;
+}
+
+template <bool Gather>
+__device__ __forceinline__ void transferEnds(const Transfer& transfer, size_t warp, size_t stride) {
+  const size_t end = transfer.prefix + transfer.tiles * TileBytes;
+  const size_t remainder = transfer.prefix + (transfer.bytes - end);
+  #pragma unroll 1
+  for (size_t i = (warp * WarpSize + threadIdx.x % WarpSize) * 4; i < remainder; i += stride * WarpSize * 4) {
+    const size_t offset = i < transfer.prefix ? i : end + (i - transfer.prefix);
+    transferWord<Gather>(transfer.src + offset, transfer.dst + offset);
+  }
+}
+
+template <bool RsFirst>
+__device__ __forceinline__ void runPaired(const Transfer& ag, const Transfer& rs, unsigned int rank) {
+  const size_t warp = size_t(threadIdx.x / WarpSize) * gridDim.x + blockIdx.x;
+  const size_t stride = size_t(blockDim.x / WarpSize) * gridDim.x;
+  const size_t sharedTiles = min(ag.tiles, rs.tiles);
+  size_t agTile = startTile(ag.tiles, rank, warp);
+  size_t rsTile = startTile(rs.tiles, rank, warp);
+  size_t work = warp;
+  #pragma unroll 1
+  for (; work < sharedTiles; work += stride) {
+    if constexpr (RsFirst) {
+      nextTile<false>(rs, rsTile, stride);
+      nextTile<true>(ag, agTile, stride);
+    } else {
+      nextTile<true>(ag, agTile, stride);
+      nextTile<false>(rs, rsTile, stride);
+    }
+  }
+  #pragma unroll 1
+  for (; work < ag.tiles; work += stride) nextTile<true>(ag, agTile, stride);
+  #pragma unroll 1
+  for (; work < rs.tiles; work += stride) nextTile<false>(rs, rsTile, stride);
+  if constexpr (RsFirst) {
+    transferEnds<false>(rs, warp, stride);
+    transferEnds<true>(ag, warp, stride);
+  } else {
+    transferEnds<true>(ag, warp, stride);
+    transferEnds<false>(rs, warp, stride);
+  }
+}
+
+template <bool Gather, bool Pause>
+__device__ __forceinline__ void runSplit(const Transfer& transfer, unsigned int rank, size_t warp, size_t stride,
+                                         uint32_t agPauseCycles) {
+  size_t tile = startTile(transfer.tiles, rank, warp);
+  #pragma unroll 1
+  for (size_t work = warp; work < transfer.tiles; work += stride) {
+    nextTile<Gather>(transfer, tile, stride);
+    if constexpr (Gather && Pause) {
+      if (agPauseCycles != 0) {
+        const auto started = static_cast<unsigned long long>(clock64());
+        while (static_cast<unsigned long long>(clock64()) - started < agPauseCycles) {}
+      }
+    }
+  }
+  transferEnds<Gather>(transfer, warp, stride);
+}
+#endif
+
+template <ncclDevFusedAgRsVariant_t Variant>
+__device__ __forceinline__ void runFused(const ncclDevComm_t& devComm, uintptr_t agSrc, uintptr_t agDst, size_t agBytes,
+                                         uintptr_t rsSrc, uintptr_t rsDst, size_t rsBytes, uint32_t agPauseCycles) {
+#if __CUDA_ARCH__ >= 900
+  ncclLsaBarrierSession<ncclCoopCta> bar{
+    ncclCoopCta(), devComm, ncclTeamTagLsa(), blockIdx.x, /*multimem=*/true};
+  bar.sync(ncclCoopCta(), cuda::memory_order_acq_rel);
+
+  if constexpr (Variant == ncclDevFusedAgRsWarpSplit || Variant == ncclDevFusedAgRsWarpSplitPause) {
+    constexpr int WarpsPerOp = FusedThreads / WarpSize / 2;
+    const unsigned int localWarp = threadIdx.x / WarpSize;
+    const size_t warp = size_t(localWarp % WarpsPerOp) * gridDim.x + blockIdx.x;
+    const size_t stride = size_t(WarpsPerOp) * gridDim.x;
+    if (localWarp < WarpsPerOp) {
+      runSplit<true, Variant == ncclDevFusedAgRsWarpSplitPause>(makeTransfer(agSrc, agDst, agBytes), devComm.rank,
+                                                               warp, stride, agPauseCycles);
+    } else {
+      runSplit<false, false>(makeTransfer(rsSrc, rsDst, rsBytes), devComm.rank, warp, stride, 0);
+    }
+  } else {
+    runPaired<Variant == ncclDevFusedAgRsRsFirst>(makeTransfer(agSrc, agDst, agBytes), makeTransfer(rsSrc, rsDst, rsBytes),
+                                                  devComm.rank);
+  }
+
+  // Publish AG writes and finish peer RS reads before reusing either window.
+  // The full CTA participates at entry and exit, including the split variants.
+  bar.sync(ncclCoopCta(), cuda::memory_order_acq_rel);
+#endif
+}
+
+} // namespace
+
+#define NCCL_FUSED_KERNEL(suffix, variant) \
+  extern "C" __global__ __launch_bounds__(FusedThreads) void ncclDevKernel_FusedAllGatherReduceScatter##suffix( \
+    const __grid_constant__ ncclDevComm_t devComm, uintptr_t agSrc, uintptr_t agDst, size_t agBytes, uintptr_t rsSrc, \
+    uintptr_t rsDst, size_t rsBytes, uint32_t agPauseCycles) { \
+    runFused<variant>(devComm, agSrc, agDst, agBytes, rsSrc, rsDst, rsBytes, agPauseCycles); \
+  }
+
+NCCL_FUSED_KERNEL(AgFirst, ncclDevFusedAgRsAgFirst)
+NCCL_FUSED_KERNEL(RsFirst, ncclDevFusedAgRsRsFirst)
+NCCL_FUSED_KERNEL(WarpSplit, ncclDevFusedAgRsWarpSplit)
+NCCL_FUSED_KERNEL(WarpSplitPause, ncclDevFusedAgRsWarpSplitPause)
+#undef NCCL_FUSED_KERNEL
+
+ncclResult_t ncclLaunchFusedAllGatherReduceScatter(const ncclDevComm_t* devComm, uintptr_t agSrc, uintptr_t agDst,
+                                                    size_t agBytes, uintptr_t rsSrc, uintptr_t rsDst, size_t rsBytes,
+                                                    int ctas, ncclDevFusedAgRsVariant_t variant, uint32_t agPauseCycles,
+                                                    cudaStream_t stream) {
+  const void* kernel;
+  switch (variant) {
+  case ncclDevFusedAgRsAgFirst:
+    kernel = reinterpret_cast<const void*>(ncclDevKernel_FusedAllGatherReduceScatterAgFirst);
+    break;
+  case ncclDevFusedAgRsRsFirst:
+    kernel = reinterpret_cast<const void*>(ncclDevKernel_FusedAllGatherReduceScatterRsFirst);
+    break;
+  case ncclDevFusedAgRsWarpSplit:
+    kernel = reinterpret_cast<const void*>(ncclDevKernel_FusedAllGatherReduceScatterWarpSplit);
+    break;
+  case ncclDevFusedAgRsWarpSplitPause:
+    kernel = reinterpret_cast<const void*>(ncclDevKernel_FusedAllGatherReduceScatterWarpSplitPause);
+    break;
+  default:
+    return ncclInvalidArgument;
+  }
+  void* args[] = {const_cast<ncclDevComm_t*>(devComm), &agSrc, &agDst, &agBytes, &rsSrc, &rsDst, &rsBytes, &agPauseCycles};
+  CUDACHECK(cudaLaunchKernel(kernel, ctas, FusedThreads, args, 0, stream));
+  return ncclSuccess;
+}
