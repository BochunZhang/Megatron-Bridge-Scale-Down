diff --git a/docs/examples/06_device_api/07_fused_ag_rs/c/main.cu b/docs/examples/06_device_api/07_fused_ag_rs/c/main.cu
new file mode 100644
index 00000000..c6fcd3a2
--- /dev/null
+++ b/docs/examples/06_device_api/07_fused_ag_rs/c/main.cu
@@ -0,0 +1,220 @@
+/*************************************************************************
+ * SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * See LICENSE.txt for more license information
+ *************************************************************************/
+
+#include <cuda_bf16.h>
+#include <cuda_runtime.h>
+#include <nccl.h>
+#include <nccl_device.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+
+#define CHECK_CUDA(call) do { \
+  cudaError_t result = (call); \
+  if (result != cudaSuccess) { \
+    std::fprintf(stderr, "%s: %s\n", #call, cudaGetErrorString(result)); \
+    std::exit(EXIT_FAILURE); \
+  } \
+} while (0)
+
+#define CHECK_NCCL(call) do { \
+  ncclResult_t result = (call); \
+  if (result != ncclSuccess) { \
+    std::fprintf(stderr, "%s: %s\n", #call, ncclGetErrorString(result)); \
+    std::exit(EXIT_FAILURE); \
+  } \
+} while (0)
+
+using Bf16 = __nv_bfloat16;
+
+struct Shape {
+  size_t agCount, rsCount, offset;
+};
+
+constexpr Shape shapes[] = {{4120, 8200, 0}, {4130, 8206, 0}, {16408, 4104, 0}, {8202, 4126, 2}};
+constexpr int trials = sizeof(shapes) / sizeof(shapes[0]);
+constexpr size_t capacity = 16416;
+constexpr int ctaCounts[] = {4, 8};
+constexpr ncclDevFusedAgRsVariant_t variants[] = {
+  ncclDevFusedAgRsAgFirst, ncclDevFusedAgRsRsFirst,
+  ncclDevFusedAgRsWarpSplit, ncclDevFusedAgRsWarpSplitPause,
+};
+
+struct Rank {
+  cudaStream_t stream;
+  ncclDevComm_t devComm;
+  ncclWindow_t agWindow, rsWindow;
+  Bf16 *agSend, *agRecv, *rsSend, *rsRecv;
+  Bf16 *agInputs[trials], *agOutputs[trials], *rsInputs[trials], *rsOutputs[trials];
+};
+
+static int agValue(int trial, int rank, size_t index) {
+  return 1 + 3 * trial + 11 * rank + index % 13;
+}
+
+static int rsValue(int trial, int rank, size_t index) {
+  return 1 + 2 * trial + 3 * rank + (index + (rank + 1) * (index % 7)) % 19;
+}
+
+static size_t bytes(size_t count) {
+  return count * sizeof(Bf16);
+}
+
+static void check(const char* op, int trial, int rank, size_t index, Bf16 actual, int expected) {
+  if (__bfloat162float(actual) != expected) {
+    std::fprintf(stderr, "%s trial %d rank %d element %zu got %.0f, expected %d\n",
+                 op, trial, rank, index, __bfloat162float(actual), expected);
+    std::exit(EXIT_FAILURE);
+  }
+}
+
+int main(int argc, char** argv) {
+  int nranks = argc == 2 ? std::atoi(argv[1]) : 2;
+  int available;
+  CHECK_CUDA(cudaGetDeviceCount(&available));
+  if (argc > 2 || (nranks != 2 && nranks != 4) || nranks > available) {
+    std::fprintf(stderr, "Usage: %s [2|4], with that many NVLink GPUs visible\n", argv[0]);
+    return EXIT_FAILURE;
+  }
+
+  std::vector<ncclComm_t> comms(nranks);
+  std::vector<Rank> ranks(nranks);
+  CHECK_NCCL(ncclCommInitAll(comms.data(), nranks, nullptr));
+  for (int rank = 0; rank < nranks; ++rank) {
+    Rank& r = ranks[rank];
+    CHECK_CUDA(cudaSetDevice(rank));
+    CHECK_CUDA(cudaStreamCreateWithFlags(&r.stream, cudaStreamNonBlocking));
+    CHECK_CUDA(cudaMalloc(&r.agSend, bytes(capacity)));
+    CHECK_CUDA(cudaMalloc(&r.rsRecv, bytes(capacity)));
+    CHECK_NCCL(ncclMemAlloc(reinterpret_cast<void**>(&r.agRecv), bytes(nranks * capacity)));
+    CHECK_NCCL(ncclMemAlloc(reinterpret_cast<void**>(&r.rsSend), bytes(nranks * capacity)));
+    for (int trial = 0; trial < trials; ++trial) {
+      CHECK_CUDA(cudaMallocHost(&r.agInputs[trial], bytes(shapes[trial].agCount)));
+      CHECK_CUDA(cudaMallocHost(&r.rsInputs[trial], bytes(nranks * shapes[trial].rsCount)));
+      CHECK_CUDA(cudaMallocHost(&r.agOutputs[trial], bytes(nranks * capacity)));
+      CHECK_CUDA(cudaMallocHost(&r.rsOutputs[trial], bytes(capacity)));
+    }
+  }
+
+  CHECK_NCCL(ncclGroupStart());
+  for (int rank = 0; rank < nranks; ++rank) {
+    Rank& r = ranks[rank];
+    CHECK_CUDA(cudaSetDevice(rank));
+    CHECK_NCCL(ncclCommWindowRegister(comms[rank], r.agRecv, bytes(nranks * capacity), &r.agWindow,
+                                     NCCL_WIN_COLL_SYMMETRIC));
+    CHECK_NCCL(ncclCommWindowRegister(comms[rank], r.rsSend, bytes(nranks * capacity), &r.rsWindow,
+                                     NCCL_WIN_COLL_SYMMETRIC));
+  }
+  CHECK_NCCL(ncclGroupEnd());
+
+  ncclDevCommRequirements reqs = NCCL_DEV_COMM_REQUIREMENTS_INITIALIZER;
+  reqs.lsaMultimem = true;
+  reqs.lsaBarrierCount = ctaCounts[1];
+  CHECK_NCCL(ncclGroupStart());
+  for (int rank = 0; rank < nranks; ++rank) {
+    CHECK_CUDA(cudaSetDevice(rank));
+    CHECK_NCCL(ncclDevCommCreate(comms[rank], &reqs, &ranks[rank].devComm));
+  }
+  CHECK_NCCL(ncclGroupEnd());
+
+  CHECK_CUDA(cudaSetDevice(0));
+  Rank& first = ranks.front();
+  if (ncclDevFusedAllGatherReduceScatter(first.agSend, first.agWindow, 0, bytes(shapes[0].agCount),
+                                       first.rsWindow, 0, first.rsRecv, shapes[0].rsCount + 1,
+                                       &first.devComm, ctaCounts[0], first.stream) != ncclInvalidArgument) {
+    std::fprintf(stderr, "Expected ncclInvalidArgument for odd BF16 RS count\n");
+    return EXIT_FAILURE;
+  }
+
+  if (ncclDevFusedAllGatherReduceScatterWithConfig(
+        first.agSend, first.agWindow, 0, bytes(shapes[0].agCount), first.rsWindow, 0, first.rsRecv, shapes[0].rsCount,
+        &first.devComm, ctaCounts[0], ncclDevFusedAgRsAgFirst, /*agPauseCycles=*/1, first.stream) != ncclInvalidArgument) {
+    std::fprintf(stderr, "Expected ncclInvalidArgument for a pause on AG-first\n");
+    return EXIT_FAILURE;
+  }
+
+  for (int ctas : ctaCounts) {
+    for (ncclDevFusedAgRsVariant_t variant : variants) {
+      const uint32_t pauseCycles = variant == ncclDevFusedAgRsWarpSplitPause ? 3072 : 0;
+      // Submit rank-local inputs, the pair, and dependent outputs on each stream.
+      // Pinned per-trial host buffers allow every launch to queue before any host wait.
+      for (int trial = 0; trial < trials; ++trial) {
+        const Shape& shape = shapes[trial];
+        for (int rank = 0; rank < nranks; ++rank) {
+          Rank& r = ranks[rank];
+          CHECK_CUDA(cudaSetDevice(rank));
+          for (size_t i = 0; i < shape.agCount; ++i) r.agInputs[trial][i] = __float2bfloat16(agValue(trial, rank, i));
+          for (size_t i = 0; i < nranks * shape.rsCount; ++i) r.rsInputs[trial][i] = __float2bfloat16(rsValue(trial, rank, i));
+          CHECK_CUDA(cudaMemsetAsync(r.agRecv, 0, bytes(nranks * capacity), r.stream));
+          CHECK_CUDA(cudaMemsetAsync(r.rsRecv, 0, bytes(capacity), r.stream));
+          CHECK_CUDA(cudaMemcpyAsync(r.agSend + shape.offset, r.agInputs[trial], bytes(shape.agCount),
+                                     cudaMemcpyHostToDevice, r.stream));
+          CHECK_CUDA(cudaMemcpyAsync(r.rsSend + shape.offset, r.rsInputs[trial], bytes(nranks * shape.rsCount),
+                                     cudaMemcpyHostToDevice, r.stream));
+          CHECK_NCCL(ncclDevFusedAllGatherReduceScatterWithConfig(
+            r.agSend + shape.offset, r.agWindow, bytes(shape.offset), bytes(shape.agCount), r.rsWindow, bytes(shape.offset),
+            r.rsRecv + shape.offset, shape.rsCount, &r.devComm, ctas, variant, pauseCycles, r.stream));
+          CHECK_CUDA(cudaMemcpyAsync(r.agOutputs[trial], r.agRecv, bytes(nranks * capacity), cudaMemcpyDeviceToHost, r.stream));
+          CHECK_CUDA(cudaMemcpyAsync(r.rsOutputs[trial], r.rsRecv, bytes(capacity), cudaMemcpyDeviceToHost, r.stream));
+        }
+      }
+
+      for (int rank = 0; rank < nranks; ++rank) {
+        Rank& r = ranks[rank];
+        CHECK_CUDA(cudaSetDevice(rank));
+        CHECK_CUDA(cudaStreamSynchronize(r.stream));
+        for (int trial = 0; trial < trials; ++trial) {
+          const Shape& shape = shapes[trial];
+          for (size_t i = 0; i < nranks * capacity; ++i) {
+            int expected = 0;
+            if (i >= shape.offset && i - shape.offset < nranks * shape.agCount) {
+              size_t dataIndex = i - shape.offset;
+              expected = agValue(trial, dataIndex / shape.agCount, dataIndex % shape.agCount);
+            }
+            check("AG", trial, rank, i, r.agOutputs[trial][i], expected);
+          }
+          for (size_t i = 0; i < capacity; ++i) {
+            int expected = 0;
+            if (i >= shape.offset && i - shape.offset < shape.rsCount) {
+              size_t dataIndex = rank * shape.rsCount + i - shape.offset;
+              for (int peer = 0; peer < nranks; ++peer) expected += rsValue(trial, peer, dataIndex);
+            }
+            check("RS", trial, rank, i, r.rsOutputs[trial][i], expected);
+          }
+        }
+      }
+      std::printf("Fused AG/RS variant %d passed on %d GPUs at %d CTA (%d queued pairs)\n",
+                  static_cast<int>(variant), nranks, ctas, trials);
+    }
+  }
+
+  CHECK_NCCL(ncclGroupStart());
+  for (int rank = 0; rank < nranks; ++rank) {
+    CHECK_CUDA(cudaSetDevice(rank));
+    CHECK_NCCL(ncclDevCommDestroy(comms[rank], &ranks[rank].devComm));
+  }
+  CHECK_NCCL(ncclGroupEnd());
+  for (int rank = 0; rank < nranks; ++rank) {
+    Rank& r = ranks[rank];
+    CHECK_CUDA(cudaSetDevice(rank));
+    CHECK_NCCL(ncclCommWindowDeregister(comms[rank], r.agWindow));
+    CHECK_NCCL(ncclCommWindowDeregister(comms[rank], r.rsWindow));
+    CHECK_NCCL(ncclMemFree(r.agRecv));
+    CHECK_NCCL(ncclMemFree(r.rsSend));
+    CHECK_CUDA(cudaFree(r.agSend));
+    CHECK_CUDA(cudaFree(r.rsRecv));
+    for (int trial = 0; trial < trials; ++trial) {
+      CHECK_CUDA(cudaFreeHost(r.agInputs[trial]));
+      CHECK_CUDA(cudaFreeHost(r.agOutputs[trial]));
+      CHECK_CUDA(cudaFreeHost(r.rsInputs[trial]));
+      CHECK_CUDA(cudaFreeHost(r.rsOutputs[trial]));
+    }
+    CHECK_CUDA(cudaStreamDestroy(r.stream));
+    CHECK_NCCL(ncclCommDestroy(comms[rank]));
+  }
+}
