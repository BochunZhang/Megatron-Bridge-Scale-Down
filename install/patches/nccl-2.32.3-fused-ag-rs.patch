diff --git a/src/dev_runtime.cc b/src/dev_runtime.cc
index 2bad06e7..bf39b5a5 100644
--- a/src/dev_runtime.cc
+++ b/src/dev_runtime.cc
@@ -2250,6 +2250,108 @@ ncclResult_t findCommAndHostWindowFromDeviceWindow(ncclWindow_t devWindow, ncclC
   return ncclSuccess;
 }
 
+ncclResult_t ncclLaunchFusedAllGatherReduceScatter(const ncclDevComm_t* devComm, uintptr_t agSrc, uintptr_t agDst,
+                                                    size_t agBytes, uintptr_t rsSrc, uintptr_t rsDst, size_t rsBytes,
+                                                  int ctas, ncclDevFusedAgRsVariant_t variant, uint32_t agPauseCycles,
+                                                  cudaStream_t stream);
+
+static bool fusedAgRsOverlap(uintptr_t first, size_t firstBytes, uintptr_t second, size_t secondBytes) {
+  return first <= second ? second - first < firstBytes : first - second < secondBytes;
+}
+
+static bool fusedAgRsWindowFits(const ncclDevrWindow* window, size_t offset, size_t shardBytes, size_t ranks) {
+  const size_t mappedBytes = window->memory->lsaMinSize;
+  const size_t windowOffset = window->bigOffset - window->memory->bigOffset;
+  if (offset > window->size || windowOffset > mappedBytes || offset > mappedBytes - windowOffset)
+    return false;
+  return shardBytes <= (window->size - offset) / ranks &&
+         shardBytes <= (mappedBytes - windowOffset - offset) / ranks;
+}
+
+NCCL_API(ncclResult_t, ncclDevFusedAllGatherReduceScatterWithConfig, const void* agSend, ncclWindow_t agRecv,
+         size_t agOffset, size_t agBytes, ncclWindow_t rsSend, size_t rsOffset, void* rsRecv, size_t rsCount,
+         const ncclDevComm_t* devComm, int ctas, ncclDevFusedAgRsVariant_t variant, uint32_t agPauseCycles,
+         cudaStream_t stream);
+ncclResult_t ncclDevFusedAllGatherReduceScatterWithConfig(
+  const void* agSend, ncclWindow_t agRecv, size_t agOffset, size_t agBytes, ncclWindow_t rsSend, size_t rsOffset,
+  void* rsRecv, size_t rsCount, const ncclDevComm_t* devComm, int ctas, ncclDevFusedAgRsVariant_t variant,
+  uint32_t agPauseCycles, cudaStream_t stream) {
+  if (variant < ncclDevFusedAgRsAgFirst || variant > ncclDevFusedAgRsWarpSplitPause ||
+      (variant != ncclDevFusedAgRsWarpSplitPause && agPauseCycles != 0))
+    return ncclInvalidArgument;
+  if (!agSend || !agRecv || !rsSend || !rsRecv || !devComm || ctas < 1 || ctas > MAXCHANNELS ||
+      agBytes == 0 || rsCount == 0 || rsCount > SIZE_MAX / 2 || rsCount % 2 != 0 ||
+      (reinterpret_cast<uintptr_t>(agSend) | reinterpret_cast<uintptr_t>(rsRecv) | agOffset | rsOffset | agBytes) % 4 != 0)
+    return ncclInvalidArgument;
+  if (devComm->magic != NCCL_API_MAGIC || devComm->version != NCCL_VERSION_CODE ||
+      ctas > devComm->lsaBarrier.nBarriers)
+    return ncclInvalidArgument;
+
+  ncclComm_t agComm, rsComm;
+  ncclDevrWindow *agWindow, *rsWindow;
+  NCCLCHECK(findCommAndHostWindowFromDeviceWindow(agRecv, &agComm, &agWindow));
+  NCCLCHECK(findCommAndHostWindowFromDeviceWindow(rsSend, &rsComm, &rsWindow));
+  if (agComm != rsComm || agComm->nRanks != devComm->nRanks || agComm->rank != devComm->rank)
+    return ncclInvalidArgument;
+  if (!agComm->nvlsSupport || agComm->minCompCap < 90 || devComm->lsaSize != devComm->nRanks ||
+      !devComm->lsaMultimem.mcBasePtr)
+    return ncclInvalidUsage;
+
+  // Match the existing LSA mapping without creating new mappings or synchronizing on the host.
+  const ncclTeam_t lsa = ncclTeamLsa(agComm);
+  const ncclDevrTeam* team = agComm->devrState.teamHead;
+  while (team && (team->team.rank != lsa.rank || team->team.nRanks != lsa.nRanks || team->team.stride != lsa.stride))
+    team = team->next;
+  if (!team || team->mcBasePtr != devComm->lsaMultimem.mcBasePtr)
+    return ncclInvalidArgument;
+
+  const size_t rsBytes = rsCount * 2;
+  const size_t ranks = agComm->nRanks;
+  if ((agWindow->winFlags & NCCL_WIN_COLL_SYMMETRIC) == 0 || (rsWindow->winFlags & NCCL_WIN_COLL_SYMMETRIC) == 0 ||
+      !ncclDevrWinRegEnabled(agWindow->winFlags, ncclDevrRegisterLsa) ||
+      !ncclDevrWinRegEnabled(rsWindow->winFlags, ncclDevrRegisterLsa) ||
+      ncclDevrWindowHasSysmemSegment(agWindow) || ncclDevrWindowHasSysmemSegment(rsWindow))
+    return ncclInvalidArgument;
+  if (!fusedAgRsWindowFits(agWindow, agOffset, agBytes, ranks) ||
+      !fusedAgRsWindowFits(rsWindow, rsOffset, rsBytes, ranks))
+    return ncclInvalidArgument;
+
+  const uintptr_t agSrc = reinterpret_cast<uintptr_t>(agSend);
+  const uintptr_t rsDst = reinterpret_cast<uintptr_t>(rsRecv);
+  const uintptr_t localAgDst = reinterpret_cast<uintptr_t>(agWindow->userPtr) + agOffset;
+  const uintptr_t localRsSrc = reinterpret_cast<uintptr_t>(rsWindow->userPtr) + rsOffset;
+  if ((localAgDst | localRsSrc) % 4 != 0 ||
+      fusedAgRsOverlap(agSrc, agBytes, localAgDst, ranks * agBytes) ||
+      fusedAgRsOverlap(agSrc, agBytes, rsDst, rsBytes) ||
+      fusedAgRsOverlap(localAgDst, ranks * agBytes, localRsSrc, ranks * rsBytes) ||
+      fusedAgRsOverlap(localAgDst, ranks * agBytes, rsDst, rsBytes) ||
+      fusedAgRsOverlap(localRsSrc, ranks * rsBytes, rsDst, rsBytes))
+    return ncclInvalidArgument;
+
+  int device;
+  CUDACHECK(cudaGetDevice(&device));
+  if (device != agComm->cudaDev) return ncclInvalidUsage;
+
+  const uintptr_t multicast = reinterpret_cast<uintptr_t>(devComm->lsaMultimem.mcBasePtr);
+  const size_t rank = agComm->rank;
+  const uintptr_t agDst = multicast + agWindow->bigOffset + agOffset + rank * agBytes;
+  const uintptr_t rsSrc = multicast + rsWindow->bigOffset + rsOffset + rank * rsBytes;
+  if ((agDst | rsSrc) % 4 != 0) return ncclInvalidArgument;
+  return ncclLaunchFusedAllGatherReduceScatter(devComm, agSrc, agDst, agBytes, rsSrc, rsDst, rsBytes, ctas,
+                                              variant, agPauseCycles, stream);
+}
+
+NCCL_API(ncclResult_t, ncclDevFusedAllGatherReduceScatter, const void* agSend, ncclWindow_t agRecv, size_t agOffset,
+         size_t agBytes, ncclWindow_t rsSend, size_t rsOffset, void* rsRecv, size_t rsCount, const ncclDevComm_t* devComm,
+         int ctas, cudaStream_t stream);
+ncclResult_t ncclDevFusedAllGatherReduceScatter(
+  const void* agSend, ncclWindow_t agRecv, size_t agOffset, size_t agBytes, ncclWindow_t rsSend, size_t rsOffset,
+  void* rsRecv, size_t rsCount, const ncclDevComm_t* devComm, int ctas, cudaStream_t stream) {
+  return ncclDevFusedAllGatherReduceScatterWithConfig(agSend, agRecv, agOffset, agBytes, rsSend, rsOffset,
+                                                     rsRecv, rsCount, devComm, ctas, ncclDevFusedAgRsAgFirst,
+                                                     /*agPauseCycles=*/0, stream);
+}
+
 NCCL_API(ncclResult_t, ncclGetMultimemDevicePointer, ncclWindow_t window, size_t offset, ncclMultimemHandle multimem,
          void** outPtr);
 ncclResult_t ncclGetMultimemDevicePointer(ncclWindow_t window, size_t offset, ncclMultimemHandle multimem,
