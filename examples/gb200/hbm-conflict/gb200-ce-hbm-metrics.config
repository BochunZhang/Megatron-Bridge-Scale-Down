version: 5
metricSets:
- alias: gb200-ce-hbm-metrics
  name: NVIDIA GB200 GEMM and copy-engine traffic
  chips: [GB100, GB102]
  displayRows:
  - name: SM Active
    type: overlay
    metrics:
    - SM Active
  - name: DRAM
    type: overlay
    metrics:
    - DRAM Read
    - DRAM Write
  - name: NVLink C2C User Data
    type: overlay
    metrics:
    - C2C RX User Data
    - C2C TX User Data
  - name: NVLink RX User Data
    type: overlay
    metrics:
    - NVLink RX Requests User Data
    - NVLink RX Responses User Data
  - name: NVLink TX User Data
    type: overlay
    metrics:
    - NVLink TX Requests User Data
    - NVLink TX Responses User Data
  metrics:
  - name: SM Active
    id: TPC.TriageCompute.sm__cycles_active
    color: Tomato
    subMetrics:
    - name: Throughput %
      suffix: .avg.pct_of_peak_sustained_elapsed
  - name: DRAM Read
    id: dram__sectors_read
    color: '#FFA5A5'
    subMetrics:
    - name: Sectors
      suffix: .sum
  - name: DRAM Write
    id: dram__sectors_write
    color: '#98C4DD'
    subMetrics:
    - name: Sectors
      suffix: .sum
  - name: C2C RX User Data
    id: CTC_B.TriageCompute.ctc__rx_bytes_data_user
    color: '#FFD179'
    subMetrics:
    - name: Bytes
      suffix: .sum
  - name: C2C TX User Data
    id: CTC_A.TriageCompute.ctc__tx_bytes_data_user
    color: '#D6A4FC'
    subMetrics:
    - name: Bytes
      suffix: .sum
  - name: NVLink RX Requests User Data
    id: NVLRX.TriageCompute.nvlrx__bytes_packet_request_data_user
    color: '#FFD179'
    subMetrics:
    - name: Bytes
      suffix: .sum
  - name: NVLink RX Responses User Data
    id: NVLRX.TriageCompute.nvlrx__bytes_packet_response_data_user
    color: '#FFA5A5'
    subMetrics:
    - name: Bytes
      suffix: .sum
  - name: NVLink TX Requests User Data
    id: NVLTX.TriageCompute.nvltx__bytes_packet_request_data_user
    color: '#D6A4FC'
    subMetrics:
    - name: Bytes
      suffix: .sum
  - name: NVLink TX Responses User Data
    id: NVLTX.TriageCompute.nvltx__bytes_packet_response_data_user
    color: '#98C4DD'
    subMetrics:
    - name: Bytes
      suffix: .sum
