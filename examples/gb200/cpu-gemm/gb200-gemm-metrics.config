version: 5
metricSets:
- alias: gb200-gemm
  name: NVIDIA GB200 GEMM memory traffic
  chips: [GB100, GB102]
  displayRows:
  - name: DRAM Bandwidth
    type: overlay
    metrics:
    - DRAM Read Bandwidth
    - DRAM Write Bandwidth
  - name: NVLink C2C User Data
    type: overlay
    metrics:
    - CTC RX Throughput User Data
    - CTC TX Throughput User Data
  metrics:
  # GB10x PM sampling counts 32-byte device-memory sectors. The SQLite export
  # keeps that raw count. The display multiplies sectors per second to GB/s.
  - name: DRAM Read Bandwidth
    id: dram__sectors_read
    color: '#FFA5A5'
    subMetrics:
    - name: Sectors
      suffix: .sum
    - name: GB/s
      suffix: .sum.per_second
      multiplier: 3.2e-08
  - name: DRAM Write Bandwidth
    id: dram__sectors_write
    color: '#98C4DD'
    subMetrics:
    - name: Sectors
      suffix: .sum
    - name: GB/s
      suffix: .sum.per_second
      multiplier: 3.2e-08
  - name: CTC RX Throughput User Data
    id: CTC_B.TriageCompute.ctc__rx_bytes_data_user
    color: '#FFD179'
    subMetrics:
    - name: Bytes
      suffix: .sum
    - name: GB/s
      suffix: .sum.per_second
      multiplier: 1.0e-09
  - name: CTC TX Throughput User Data
    id: CTC_A.TriageCompute.ctc__tx_bytes_data_user
    color: '#D6A4FC'
    subMetrics:
    - name: Bytes
      suffix: .sum
    - name: GB/s
      suffix: .sum.per_second
      multiplier: 1.0e-09
