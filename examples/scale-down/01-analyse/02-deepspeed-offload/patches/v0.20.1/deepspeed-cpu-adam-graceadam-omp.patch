+#include <stdexcept>
+
+inline int graceadam_sve_num_threads()
+{
+    const char* value = std::getenv("MEGATRON_GRACEADAM_OMP_THREADS");
+    if (value == nullptr) { return omp_get_max_threads(); }
+
+    int threads = 0;
+    const char* end = value + std::strlen(value);
+    const auto parsed = std::from_chars(value, end, threads);
+    if (parsed.ec != std::errc{} || parsed.ptr != end || threads < 1) {
+        throw std::invalid_argument("MEGATRON_GRACEADAM_OMP_THREADS must be a positive integer");
+    }
+    return threads;
+}
+#endif

